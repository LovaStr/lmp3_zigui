    //   zig fetch --save git+https://github.com/braheezy/zoto
    //   zig fetch --save git+https://github.com/mackron/dr_libs
    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}
